# gunicorn, as a service.
#
#   sudo cp systemd/agrozanjir-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now agrozanjir-api
#
# CHANGE ME: User, WorkingDirectory and the path to the virtualenv.

[Unit]
Description=Agro Zanjir Digital API (gunicorn)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=notify
User=agrozanjir
Group=agrozanjir
WorkingDirectory=/srv/agrozanjir/backend
Environment=DJANGO_SETTINGS_MODULE=config.settings
# Settings come from the .env beside manage.py, which is read by
# django-environ at import. It is not in the repository and must not be.
ExecStart=/srv/agrozanjir/backend/.venv/bin/gunicorn config.wsgi:application \
    --bind 127.0.0.1:8000 \
    --workers 3 \
    --timeout 120 \
    --access-logfile - \
    --error-logfile -

# A restart must not drop a request that is already being served.
ExecReload=/bin/kill -s HUP $MAINPID
KillSignal=SIGTERM
Restart=on-failure
RestartSec=5s

# The service needs its own directory and nothing else.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target

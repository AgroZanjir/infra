# Copy to .env and fill in. Nothing here is read in production without being set.

DEBUG=True
DJANGO_SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL 16 is the target. Leave DATABASE_URL unset and the shell falls
# back to SQLite so it boots before a database exists.
# DATABASE_URL=postgres://agro:agro@localhost:5432/agro_zanjir

# The web shell's Vite dev server.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Section 04 - one variable per port. `manual` means an operator keys the
# decision in from the admin. Swapping in a live adapter changes nothing else.
LENDER_ADAPTER=manual
INSURER_ADAPTER=manual
CARRIER_ADAPTER=manual
CUSTOMS_ADAPTER=manual
SENSOR_ADAPTER=manual

# Identity. OneID is the identity source; `stub` resolves a demo persona
# instead and says so in the sign-in response, which is what the sign-in
# screen's banner reads. There is no other adapter yet.
ONEID_ADAPTER=stub

# Sessions. The access token lives in the browser's memory for the life of the
# tab; the refresh token is an httpOnly cookie the client cannot read.
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
# Over plain http in development a Secure cookie is dropped silently, so this
# follows DEBUG unless you set it.
# REFRESH_COOKIE_SECURE=False

# --- the assistant ------------------------------------------------------
# Off unless a key is set, and it says so rather than pretending: the widget
# asks the API whether it is available before it offers anybody a text box.
# The key is read from the environment and belongs in this file, never in the
# repository.
# ANTHROPIC_API_KEY=sk-ant-...
# ASSISTANT_ADAPTER=auto           # auto | claude | off
# ASSISTANT_MODEL=claude-opus-5
# The one public endpoint that costs money per request, so the one that is
# rate limited. Per address, and per process unless CACHES is shared.
# ASSISTANT_BURST_RATE=6/min
# ASSISTANT_HOUR_RATE=40/hour
# Behind a session, so keyed on the person and far looser.
# ASSISTANT_PANEL_RATE=120/hour

# --- the contact form ---------------------------------------------------
# It costs nothing to answer, but it is the one table a stranger can put rows
# in. Bounded the same way, per address.
# ENQUIRY_BURST_RATE=3/min
# ENQUIRY_DAY_RATE=20/day

# --- deployment ---------------------------------------------------------
# With DEBUG=False the security settings at the bottom of config/settings.py
# switch on by themselves: TLS redirect, HSTS, secure cookies, and the proxy
# header Django needs to know a request arrived over HTTPS.

# DEBUG=False
# DJANGO_SECRET_KEY=<50+ random characters, never the default>
# ALLOWED_HOSTS=agrozanjir.uz,api.agrozanjir.uz
# CORS_ALLOWED_ORIGINS=https://agrozanjir.uz
# CSRF_TRUSTED_ORIGINS=https://agrozanjir.uz
# DATABASE_URL=postgres://agro:<password>@localhost:5432/agro_zanjir

# The refresh cookie. `Lax` is right while the web client and the API share a
# registrable domain (agrozanjir.uz and api.agrozanjir.uz do). On genuinely
# different domains a Lax cookie is never sent with an XHR, and this has to
# become `None` - which browsers accept only together with Secure.
# REFRESH_COOKIE_SAMESITE=Lax
# REFRESH_COOKIE_SECURE=True

# Set to False only if something in front already redirects http to https.
# SECURE_SSL_REDIRECT=True

# Copy to .env.local for development, or set at build time in CI.
#
# Vite inlines these at build time, not at run time: a production bundle
# already contains whatever this was when `npm run build` ran. Changing the
# API's address means building again.

# Where the Django API is. Defaults to http://localhost:8000.
VITE_API_BASE_URL=http://localhost:8000
